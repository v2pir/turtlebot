<?xml version="1.0"?>
<sdf version="1.8">
  <world name="cuttlebot_world">

    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- gazebo plugins -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Room: 8m x 6m enclosed space
      Walls are 0.15m thick, 2.5m tall
      Origin is at center of room
    -->

    <!-- north wall (along +y) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- south wall (along -y) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- east wall (along +x) -->
    <model name="wall_east">
      <static>true</static>
      <pose>4.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- west wall (along -x) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Underwater scenery: kelp stalks, algae patches, and rocks.
      Placed asymmetrically along walls to help AMCL localize.
      Center corridor (x: -1 to 1) kept clear for robot navigation.
    -->

    <!-- kelp: tall thin cylinders (dark green) -->
    <model name="kelp_1">
      <static>true</static>
      <pose>-3.2 -0.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.18</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.4 0.15 1</ambient>
            <diffuse>0.1 0.45 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kelp_2">
      <static>true</static>
      <pose>-3.0 -0.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.8</length></cylinder></geometry>
          <material>
            <ambient>0.08 0.35 0.12 1</ambient>
            <diffuse>0.08 0.38 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kelp_3">
      <static>true</static>
      <pose>3.2 1.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.20</radius><length>1.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.20</radius><length>1.0</length></cylinder></geometry>
          <material>
            <ambient>0.1 0.4 0.15 1</ambient>
            <diffuse>0.1 0.45 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="kelp_4">
      <static>true</static>
      <pose>-2.5 2.3 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.17</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.17</radius><length>0.7</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.42 0.18 1</ambient>
            <diffuse>0.12 0.45 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- algae patches: low flat clusters (green-brown) -->
    <model name="algae_1">
      <static>true</static>
      <pose>2.8 -2.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.45 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.45 0.5</size></box></geometry>
          <material>
            <ambient>0.2 0.35 0.1 1</ambient>
            <diffuse>0.2 0.38 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="algae_2">
      <static>true</static>
      <pose>-2.0 -2.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.15 0.3 0.08 1</ambient>
            <diffuse>0.15 0.32 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- rocks: small irregular shapes (gray-brown) -->
    <model name="rock_1">
      <static>true</static>
      <pose>3.0 -0.8 0.15 0 0 0.3</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.45 0.35 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.45 0.35 0.3</size></box></geometry>
          <material>
            <ambient>0.4 0.35 0.28 1</ambient>
            <diffuse>0.4 0.35 0.28 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rock_2">
      <static>true</static>
      <pose>-1.8 1.8 0.125 0 0 0.7</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.3 0.25</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.25</size></box></geometry>
          <material>
            <ambient>0.35 0.3 0.25 1</ambient>
            <diffuse>0.35 0.3 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- corridor pillar — breaks L/R symmetry near robot path -->
    <model name="corridor_pillar_1">
      <static>true</static>
      <pose>-1.5 -0.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.45 0.4 0.3 1</ambient>
            <diffuse>0.45 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- rock near CENTER area -->
    <model name="corridor_rock_2">
      <static>true</static>
      <pose>1.5 -2.0 0.15 0 0 0.5</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.35 0.25 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.35 0.25 0.3</size></box></geometry>
          <material>
            <ambient>0.38 0.33 0.26 1</ambient>
            <diffuse>0.38 0.33 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- large NE corner feature — breaks north wall symmetry -->
    <model name="corner_feature_ne">
      <static>true</static>
      <pose>3.0 2.2 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.4 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.6</size></box></geometry>
          <material>
            <ambient>0.3 0.28 0.22 1</ambient>
            <diffuse>0.3 0.28 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Divider wall with 1.2m gap at y=1.0
      Creates physical chambers and gives AMCL a major asymmetric lidar feature.
      Left wall: x=-4.0 to x=-0.6, right wall: x=0.6 to x=4.0
    -->
    <model name="divider_left">
      <static>true</static>
      <pose>-2.3 1.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.4 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.4 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="divider_right">
      <static>true</static>
      <pose>2.3 1.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.4 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.4 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- left chamber marker (yellow = live shrimp) -->
    <model name="marker_left">
      <static>true</static>
      <pose>-0.8 2.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.1 1</ambient>
            <diffuse>0.9 0.9 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- right chamber marker (red = dead shrimp) — visible through gap from approach -->
    <model name="marker_right">
      <static>true</static>
      <pose>0.8 2.0 0.4 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
          <material>
            <ambient>0.9 0.2 0.1 1</ambient>
            <diffuse>0.9 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

<?xml version="1.0"?>
<sdf version="1.8">
  <world name="cuttlebot_world">

    <physics type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- gazebo plugins -->
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />

    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.3 0.7 0.9 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <!-- ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.85 1</ambient>
            <diffuse>0.85 0.85 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Room: 8m x 6m enclosed space
      Walls are 0.15m thick, 2.5m tall
      Origin is at center of room
    -->

    <!-- north wall (along +y) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- south wall (along -y) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.075 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8.3 0.15 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- east wall (along +x) -->
    <model name="wall_east">
      <static>true</static>
      <pose>4.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- west wall (along -x) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-4.075 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 6.0 2.5</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Delayed Gratification Experiment Layout
      Divider wall at y=0 splits room into:
        - South half: CENTER area (robot start, y < 0)
        - North half: LEFT and RIGHT chambers (y > 0)
      1.2m gap in center of divider for robot passage
    -->

    <!-- divider wall: left segment -->
    <model name="divider_left">
      <static>true</static>
      <pose>-2.3 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.4 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.4 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- divider wall: right segment -->
    <model name="divider_right">
      <static>true</static>
      <pose>2.3 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.4 0.1 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.4 0.1 2.5</size></box></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- left chamber marker (blue) — flat on ground -->
    <model name="marker_left">
      <static>true</static>
      <pose>-2.5 2.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.02</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- right chamber marker (red) — flat on ground -->
    <model name="marker_right">
      <static>true</static>
      <pose>2.5 2.5 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.0 1.0 0.02</size></box></geometry>
          <material>
            <ambient>0.9 0.2 0.1 1</ambient>
            <diffuse>0.9 0.2 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
